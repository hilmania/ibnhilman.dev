---
import type { MarkdownHeading } from "astro";

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;

// Hanya h2 dan h3 — lebih dalam dari itu membuat daftarnya jadi ramai.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 3 && (
  <nav class="toc" aria-label="Daftar isi">
    <p class="label">Isi</p>
    <ol>
      {items.map((h) => (
        <li data-depth={h.depth}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    border-left: 2px solid var(--line);
    padding: 2px 0 2px 16px;
    margin-bottom: 36px;
    max-width: var(--measure);
  }
  .toc ol { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .toc li[data-depth="3"] { padding-left: 16px; }
  .toc a { font-family: var(--mono); font-size: 12.5px; color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--accent); }
</style>
