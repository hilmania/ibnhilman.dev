---
interface Props {
  title: string;
  tagline: string;
  priceFrom: string;
  duration: string;
  href: string;
}
const { title, tagline, priceFrom, duration, href } = Astro.props;
---
<a class="card svc" href={href}>
  <h3>{title}</h3>
  <p class="muted tag">{tagline}</p>
  <p class="meta mono tabular">{priceFrom} · {duration}</p>
</a>

<style>
  .svc {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    border-top: 3px solid var(--accent);
  }
  .svc:hover { background: var(--sunk); }
  .tag { font-size: 14.5px; flex: 1; }
  .meta { font-size: 12px; color: var(--accent); }
</style>
