---
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  lede?: string;
  eyebrow?: string;
}
const { title, description, lede, eyebrow } = Astro.props;
---
<Base title={title} description={description ?? lede}>
  <div class="wrap head">
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede measure">{lede}</p>}
  </div>
  <div class="wrap body">
    <slot />
  </div>
</Base>

<style>
  .head { padding-block: 48px 0; display: flex; flex-direction: column; gap: 16px; }
  .body { padding-block: 36px 60px; }
</style>
