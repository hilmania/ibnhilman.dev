---
import { getCollection } from "astro:content";
import Page from "../../../layouts/Page.astro";
import PostCard from "../../../components/PostCard.astro";
import { readingTime, sortByDate, categorySlug } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))];

  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      posts: sortByDate(posts.filter((p) => p.data.category === category)),
    },
  }));
}

const { category, posts } = Astro.props;
---
<Page
  eyebrow="Kategori"
  title={category}
  lede={`${posts.length} artikel dalam kategori ini.`}
  description={`Artikel dalam kategori ${category}.`}
>
  <p class="back mono"><a href="/blog">← Semua tulisan</a></p>
  <div class="list">
    {posts.map((post) => (
      <PostCard
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        category={post.data.category}
        minutes={readingTime(post.body)}
        hasVideo={Boolean(post.data.video)}
      />
    ))}
  </div>
</Page>

<style>
  .back { font-size: 12.5px; margin-bottom: 18px; }
</style>
