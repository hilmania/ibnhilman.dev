---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site, problems, process } from "../site.config";

const services = (await getCollection("services", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const work = (await getCollection("work", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <section class="hero-shell">
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> INDEPENDENT DEVELOPER · INDONESIA</p>
        <h1>Software that<br /><em>makes work</em><br />work better.</h1>
        <p class="hero-lede">{site.positioning}</p>
        <div class="hero-actions">
          <a class="btn btn-solid" href="/book">Book a discovery call</a>
          <a class="text-link" href="/work">Explore my work</a>
        </div>
        <div class="hero-proof">
          <span>{site.stats.yearsInDelivery}+ YEARS IN IT DELIVERY</span>
          <span>DJANGO · REACT · POSTGRESQL</span>
        </div>
      </div>
      <div class="hero-visual" aria-label="Illustration of a project moving from scope to launch">
        <div class="visual-top"><span class="visual-dot"></span> A BETTER WAY TO BUILD <span>01 / 03</span></div>
        <div class="visual-main">
          <div class="visual-label">FROM IDEA TO WORKING SYSTEM</div>
          <div class="diagram">
            <div class="diagram-node"><span class="node-icon">01</span><strong>Define the problem</strong><small>Scope &amp; architecture</small></div>
            <div class="diagram-connector"></div>
            <div class="diagram-node active"><span class="node-icon">02</span><strong>Build in the open</strong><small>Weekly working demos</small></div>
            <div class="diagram-connector"></div>
            <div class="diagram-node"><span class="node-icon">03</span><strong>Hand it over</strong><small>Code, docs &amp; ownership</small></div>
          </div>
        </div>
        <div class="visual-bottom"><span>Clarity at every step.</span><span class="visual-mark">✳</span></div>
      </div>
    </div>
    {site.availability.open && <div class="wrap availability"><span class="availability-dot"></span>{site.availability.label}<span class="availability-end">/ CURRENT AVAILABILITY</span></div>}
  </section>

  <section class="section wrap intro-section">
    <div class="section-heading"><p class="label">01 / THE CHALLENGE</p><h2>Good software starts with the right questions.</h2></div>
    <div class="problem-list">
      {problems.map((p) => <div class="problem"><span class="problem-symbol" aria-hidden="true">✳</span><div><h3>{p.title}</h3><p>{p.body}</p></div></div>)}
    </div>
  </section>

  <section class="services-band">
    <div class="wrap">
      <div class="section-heading heading-inline"><div><p class="label">02 / WHAT I DO</p><h2>From first sketch<br />to dependable launch.</h2></div><p>Choose the support your project needs, with a clear outcome at every stage.</p></div>
      <div class="services-list">
        {services.map((s, i) => <a class="service-row" href={`/services/${s.id}`}><span class="service-index">{String(i + 1).padStart(2, "0")}</span><div><h3>{s.data.title}</h3><p>{s.data.tagline}</p></div><span class="service-meta">{s.data.duration}<br />{s.data.priceFrom}</span><span class="service-icon" aria-hidden="true">+</span></a>)}
      </div>
      <a class="band-link" href="/services">View all services</a>
    </div>
  </section>

  <section class="section wrap process-section">
    <div class="section-heading"><p class="label">03 / HOW I WORK</p><h2>A process you can see.<br />A product you can own.</h2></div>
    <ol class="process-grid">{process.map((p, i) => <li><span class="process-number">{String(i + 1).padStart(2, "0")}</span><h3>{p.step}</h3><p>{p.body}</p></li>)}</ol>
  </section>

  {work.length > 0 && <section class="section wrap work-section"><div class="section-heading heading-inline"><div><p class="label">04 / SELECTED WORK</p><h2>Built for real work.</h2></div><a class="text-link" href="/work">All case studies</a></div><div class="work-grid">{work.map((w) => <a href={`/work/${w.id}`} class="work-card"><span class="label">{w.data.industry}</span><h3>{w.data.title}</h3><p>{w.data.result}</p><span class="work-stack">{w.data.stack.join(" · ")}</span></a>)}</div></section>}

  {posts.length > 0 && <section class="section wrap writing-section"><div class="section-heading heading-inline"><div><p class="label">{work.length > 0 ? "05" : "04"} / NOTES FROM THE FIELD</p><h2>Writing &amp; thinking.</h2></div><a class="text-link" href="/blog">More writing</a></div><div class="post-list">{posts.map((p) => <a href={`/blog/${p.id}`}><span>{p.data.date.toISOString().slice(0, 10)}</span><strong>{p.data.title}</strong></a>)}</div></section>}

  <section class="closing-shell"><div class="wrap closing"><div><p class="label">LET'S MAKE IT REAL</p><h2>Have a process that<br />should work better?</h2><p>Tell me what your team is dealing with. We will start by making the problem clear.</p></div><a class="btn btn-dark" href="/book">Let's talk about it</a></div></section>
</Base>

<style>
.hero-shell {
  background: #101c1c;
  color: #f5f7ef;
  overflow: hidden;
}
.hero {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 7%;
  padding-block: 108px 94px;
}
.eyebrow,
.visual-label,
.visual-top,
.hero-proof,
.availability,
.service-index,
.service-meta,
.process-number,
.work-stack,
.post-list span {
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.09em;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #b1c8b7;
  margin-bottom: 28px;
}
.eyebrow-line {
  width: 25px;
  height: 1px;
  background: var(--lime);
}
.hero h1 {
  font-size: clamp(3.5rem, 6vw, 6.6rem);
  line-height: 0.98;
  letter-spacing: -0.075em;
  font-weight: 700;
  max-width: 760px;
}
.hero h1 em {
  font-family: var(--body);
  font-weight: 400;
  color: var(--lime);
  letter-spacing: -0.06em;
}
.hero-lede {
  font-family: var(--body);
  font-size: clamp(1.1rem, 1.6vw, 1.35rem);
  line-height: 1.48;
  color: #c4d0c8;
  max-width: 570px;
  margin-top: 32px;
}
.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 28px;
  margin-top: 34px;
}
.hero-actions .btn {
  background: var(--lime);
  border-color: var(--lime);
  color: #101c1c;
}
.text-link {
  color: inherit;
  text-decoration: none;
  font-family: var(--display);
  font-weight: 700;
  border-bottom: 1px solid currentColor;
  padding-bottom: 4px;
  display: inline-flex;
  gap: 28px;
  align-items: center;
}
.text-link:hover {
  gap: 36px;
}
.hero-proof {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 28px;
  color: #8ea69b;
  margin-top: 76px;
}
.hero-visual {
  min-height: 510px;
  background: #192a28;
  border: 1px solid #38544b;
  box-shadow: 25px 25px 0 #162321;
  transform: rotate(2deg);
  display: flex;
  flex-direction: column;
}
.visual-top {
  padding: 18px 22px;
  display: flex;
  gap: 10px;
  align-items: center;
  border-bottom: 1px solid #38544b;
  color: #cbdccf;
}
.visual-top > span:last-child {
  margin-left: auto;
  color: #739486;
}
.visual-dot,
.availability-dot {
  width: 8px;
  height: 8px;
  background: var(--lime);
  border-radius: 50%;
  display: inline-block;
  flex: none;
}
.visual-main {
  padding: 42px 34px;
  flex: 1;
}
.visual-label {
  color: #91af9e;
  margin-bottom: 30px;
}
.diagram {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.diagram-node {
  display: grid;
  grid-template-columns: 45px 1fr;
  gap: 1px 13px;
  padding: 14px 16px;
  border: 1px solid #436054;
  background: #223731;
}
.diagram-node.active {
  background: var(--lime);
  color: #14231d;
  border-color: var(--lime);
  transform: translateX(13px);
}
.node-icon {
  grid-row: span 2;
  align-self: center;
  font-family: var(--mono);
  font-size: 0.85rem;
  border: 1px solid currentColor;
  border-radius: 50%;
  width: 33px;
  height: 33px;
  display: grid;
  place-items: center;
}
.diagram-node strong {
  font-family: var(--display);
  font-size: 1rem;
}
.diagram-node small {
  font-family: var(--mono);
  font-size: 0.68rem;
  opacity: 0.73;
}
.diagram-connector {
  height: 25px;
  width: 1px;
  background: #789686;
  margin-left: 36px;
}
.visual-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #38544b;
  padding: 13px 21px;
  font-family: var(--body);
  font-style: italic;
  color: #c1d4c4;
}
.visual-mark {
  font-style: normal;
  color: var(--lime);
  font-size: 1.8rem;
  line-height: 1;
}
.availability {
  border-top: 1px solid #395046;
  padding-block: 15px 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #d7e8d8;
}
.availability-end {
  margin-left: auto;
  color: #779887;
}
.section {
  padding-block: 100px;
  border: 0;
}
.section-heading .label {
  color: var(--accent);
  margin-bottom: 19px;
}
.section-heading h2 {
  font-size: clamp(2.3rem, 4.5vw, 4.4rem);
  line-height: 1.05;
  letter-spacing: -0.055em;
  max-width: 750px;
}
.intro-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10%;
}
.problem-list {
  border-top: 1px solid var(--line);
}
.problem {
  display: grid;
  grid-template-columns: 26px 1fr;
  gap: 18px;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}
.problem-symbol {
  color: var(--accent);
  font-size: 1.3rem;
  line-height: 1.1;
}
.problem h3 {
  font-size: 1.08rem;
  line-height: 1.35;
  margin-bottom: 7px;
}
.problem p {
  font-size: 0.96rem;
  color: var(--muted);
  line-height: 1.5;
}
.services-band {
  background: #e7ece5;
  padding-block: 100px;
}
.heading-inline {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
}
.heading-inline > p {
  max-width: 290px;
  color: var(--muted);
  font-size: 1.05rem;
}
.services-list {
  margin-top: 50px;
  border-top: 1px solid #bdc9bd;
}
.service-row {
  display: grid;
  grid-template-columns: 50px minmax(0, 1fr) 140px 32px;
  gap: 20px;
  align-items: center;
  padding: 26px 4px;
  border-bottom: 1px solid #bdc9bd;
  color: var(--fg);
  text-decoration: none;
}
.service-row:hover {
  padding-inline: 16px;
  background: #d9e3d5;
}
.service-index {
  color: var(--accent);
}
.service-row h3 {
  font-size: clamp(1.35rem, 2.2vw, 2rem);
  letter-spacing: -0.04em;
}
.service-row p {
  color: var(--muted);
  font-size: 0.95rem;
  margin-top: 4px;
}
.service-meta {
  line-height: 1.7;
  color: var(--muted);
  letter-spacing: 0;
}
.service-icon {
  font-size: 1.5rem;
  color: var(--accent);
}
.band-link {
  display: inline-flex;
  gap: 32px;
  margin-top: 32px;
  color: var(--fg);
  font-family: var(--display);
  font-weight: 700;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 5px;
}
.process-section {
  border-bottom: 1px solid var(--line);
}
.process-grid {
  list-style: none;
  padding: 0;
  margin: 52px 0 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.process-grid li {
  border-top: 2px solid var(--accent);
  padding-top: 20px;
}
.process-number {
  color: var(--accent);
}
.process-grid h3 {
  font-size: 1.35rem;
  margin: 38px 0 10px;
}
.process-grid p {
  color: var(--muted);
  font-size: 0.97rem;
}
.work-section,
.writing-section {
  border-bottom: 1px solid var(--line);
}
.work-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 40px;
}
.work-card {
  padding: 28px;
  min-height: 290px;
  background: #e7ece5;
  color: var(--fg);
  text-decoration: none;
  display: flex;
  flex-direction: column;
}
.work-card h3 {
  font-size: 1.7rem;
  margin: 25px 0 12px;
}
.work-card p {
  color: var(--muted);
}
.work-stack {
  margin-top: auto;
  padding-top: 24px;
  color: var(--accent);
}
.post-list {
  margin-top: 36px;
  border-top: 1px solid var(--line);
}
.post-list a {
  display: grid;
  grid-template-columns: 140px 1fr 24px;
  gap: 18px;
  align-items: center;
  padding: 22px 0;
  border-bottom: 1px solid var(--line);
  color: var(--fg);
  text-decoration: none;
}
.post-list a:hover strong {
  color: var(--accent);
}
.post-list span {
  color: var(--muted);
}
.post-list strong {
  font-family: var(--display);
  font-size: 1.1rem;
}
.closing-shell {
  background: var(--lime);
  color: #10211b;
}
.closing {
  padding-block: 85px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
}
.closing .label {
  color: #3a6851;
  margin-bottom: 24px;
}
.closing h2 {
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 1;
  letter-spacing: -0.06em;
}
.closing p:not(.label) {
  font-size: 1.1rem;
  max-width: 520px;
  margin-top: 24px;
}
.btn-dark {
  background: #10211b;
  border-color: #10211b;
  color: #f5f7ef;
  white-space: nowrap;
}
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding-block: 70px;
  }
  .hero-visual {
    max-width: 560px;
    min-height: 440px;
    transform: none;
    box-shadow: 14px 14px 0 #162321;
  }
  .hero-proof {
    margin-top: 45px;
  }
  .intro-section {
    grid-template-columns: 1fr;
    gap: 35px;
  }
  .process-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .closing {
    align-items: start;
    flex-direction: column;
  }
}
@media (max-width: 600px) {
  .hero {
    padding-block: 55px;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 14vw, 5rem);
  }
  .hero-visual {
    min-height: 420px;
  }
  .visual-main {
    padding: 30px 20px;
  }
  .section,
  .services-band {
    padding-block: 65px;
  }
  .heading-inline {
    align-items: start;
    flex-direction: column;
    gap: 20px;
  }
  .service-row {
    grid-template-columns: 28px 1fr 24px;
    gap: 12px;
  }
  .service-meta {
    grid-column: 2;
    grid-row: 2;
  }
  .service-icon {
    grid-column: 3;
    grid-row: 1;
  }
  .process-grid {
    gap: 35px 18px;
  }
  .process-grid h3 {
    margin-top: 24px;
  }
  .work-grid {
    grid-template-columns: 1fr;
  }
  .post-list a {
    grid-template-columns: 1fr 24px;
  }
  .post-list a span:first-child {
    grid-column: 1/-1;
  }
  .post-list strong {
    grid-column: 1;
  }
  .availability-end {
    display: none;
  }
}
</style>
<style>
  .services-band { --fg: #14231d; --muted: #56675e; --accent: #17634b; }
  .work-card { --fg: #14231d; --muted: #56675e; --accent: #17634b; }
  .closing-shell { --fg: #10211b; }
</style>
