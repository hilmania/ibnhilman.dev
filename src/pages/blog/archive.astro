---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { groupByYear, formatDate } from "../../lib/posts";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const years = groupByYear(posts);
---
<Page eyebrow="Arsip" title="Semua tulisan" lede={`${posts.length} artikel, terbaru lebih dulu.`}>
  {years.map(([year, items]) => (
    <section class="year">
      <h2>{year}</h2>
      <ul>
        {items.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="mono date">{formatDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Page>

<style>
  .year { margin-bottom: 36px; }
  .year ul { list-style: none; margin: 14px 0 0; padding: 0; }
  .year li {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-block: 10px; border-bottom: 1px solid var(--line);
  }
  .year a { text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 15.5px; }
  .date { font-size: 11.5px; color: var(--muted); }
</style>
